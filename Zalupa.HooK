-- [BLOCK 10] VIEWMODEL & CAMERA FX
-- ═══════════════════════════════════════════════════════════════════════════
ViewmodelGroup:AddSlider("vm_x", { Text = "X Offset", Min = -50, Max = 50, Rounding = 0, Default = 0, Callback = function(v) vm_x = v end })
ViewmodelGroup:AddSlider("vm_y", { Text = "Y Offset", Min = -50, Max = 50, Rounding = 0, Default = 0, Callback = function(v) vm_y = v end })
ViewmodelGroup:AddSlider("vm_z", { Text = "Z Offset", Min = -50, Max = 50, Rounding = 0, Default = 0, Callback = function(v) vm_z = v end })

local function apply_vm_offset()
    local vm = Camera:FindFirstChild("ViewModel")
    if not vm then return end
    local hrp = vm:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local vec = Vector3.new(vm_x/10, vm_y/10, vm_z/10)
    local function apply_joint(name)
        local joint = hrp:FindFirstChild(name)
        if joint and joint:IsA("Motor6D") then
            if not joint:GetAttribute("OriginalC0") then
                joint:SetAttribute("OriginalC0", joint.C0)
            end
            joint.C0 = joint:GetAttribute("OriginalC0") + vec
        end
    end
    apply_joint("LeftUpperArm"); apply_joint("RightUpperArm")
    apply_joint("ItemRoot"); apply_joint("Motor6D")
end
cheat.utility.new_heartbeat(apply_vm_offset)

CameraGroup:AddToggle("cam_fov", { Text = "FOV Override", Default = false, Callback = function(v) cam_fov_enabled = v end })
CameraGroup:AddSlider("cam_fov_size", { Text = "FOV Size", Min = 10, Max = 120, Rounding = 0, Default = 70, Callback = function(v) cam_fov_size = v end })

local zoomToggle = CameraGroup:AddToggle("cam_zoom", { Text = "Zoom", Default = false, Callback = function(v) cam_zoom_enabled = v end })
zoomToggle:AddKeyPicker("zoom_key", { Default = "None", Text = "Zoom Keybind", Mode = "Hold", SyncToggleState = true, Callback = function(state) cam_zoom_enabled = state end })

CameraGroup:AddSlider("cam_zoom_size", { Text = "Zoom Size", Min = 1, Max = 90, Rounding = 0, Default = 10, Callback = function(v) cam_zoom_size = v end })
CameraGroup:AddToggle("cam_noscreen", { Text = "No Screen Effects", Default = false, Callback = function(v) no_screen_fx = v end })

cheat.utility.new_renderstepped(function()
    local target_fov = cam_zoom_enabled and cam_zoom_size or cam_fov_enabled and cam_fov_size
    if target_fov and Camera.FieldOfView ~= target_fov then
        Camera.FieldOfView = target_fov
    end
end)

Camera.DescendantAdded:Connect(remove_muzzle_flash)

local _se_cache = nil
local function _find_se()
    local pg = LocalPlayer.PlayerGui
    local ni = pg and pg:FindFirstChild("NoInsetGui")
    local mf = ni and ni:FindFirstChild("MainFrame")
    return mf and mf:FindFirstChild("ScreenEffects")
end
LocalPlayer.PlayerGui.DescendantAdded:Connect(function(d) if d.Name == "ScreenEffects" then _se_cache = d end end)
_se_cache = _find_se()

cheat.utility.new_heartbeat(function()
    if no_muzzle_flash then
        for _, v in Camera:GetDescendants() do remove_muzzle_flash(v) end
    end
    if not _se_cache or not _se_cache.Parent then _se_cache = _find_se() end
    if _se_cache then _se_cache.Visible = not no_screen_fx end
end)

local function spawn_hit_effect(pos)
    if not hit_effect_enabled then return end
    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 1
    part.Position = pos
    part.Parent = workspace.Terrain

    local emit = Instance.new("ParticleEmitter")
    emit.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emit.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0)})
    emit.Color = ColorSequence.new(Color3.new(1, 1, 1))
    emit.LightEmission = 1
    emit.LightInfluence = 0
    emit.ZOffset = 1
    emit.Lifetime = NumberRange.new(1, 2)
    emit.Rate = 0
    emit.Speed = NumberRange.new(15, 40)
    emit.SpreadAngle = Vector2.new(360, 360)
    emit.Drag = 2
    emit.Parent = part
    emit:Emit(hit_effect_amount)
    game:GetService("Debris"):AddItem(part, 3)
end

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 11] ITEM FINDER (из pin.reta — обновлённый, dict lookup)
-- ═══════════════════════════════════════════════════════════════════════════
local item_list = {}
pcall(function()
    local il = ItemsListFolder
    if il then
        for _,it in pairs(il:GetChildren()) do
            local p = it:FindFirstChild("ItemProperties")
            if it.Name ~= "Lighter" and not (p and p:GetAttribute("ItemType")=="Melee") then
                table.insert(item_list, it.Name)
            end
        end
    end
end)
table.sort(item_list, function(a,b) return string.lower(a)<string.lower(b) end)

local finder_glow_size = 5
local finder_glow_color = Color3.fromRGB(120,110,180)
ItemFinderGroup:AddDropdown("find_items", { Text = "Items To Find", Values = item_list, Default = {}, Multi = true, Callback = function(v) selected_finder_items = v end })
local finder_toggle = ItemFinderGroup:AddToggle("find_on", { Text = "Enable Item Finder", Default = false, Callback = function() end })
finder_toggle:AddColorPicker("find_col", { Title = "Color", Default = Color3.fromRGB(120,110,180), Callback = function(v) finder_glow_color = v end })

ItemFinderGroup:AddToggle("find_on_esp", { Text = "Show Selected Items on Player ESP", Default = false, Callback = function(v) item_finder_esp_enabled = v end })

ItemFinderGroup:AddSlider("find_glow", { Text = "Glow Size", Min = 1, Max = 15, Rounding = 0, Default = 5, Callback = function(v) finder_glow_size = v end })
ItemFinderGroup:AddSlider("find_x", { Text = "Finder X Pos", Min = 0, Max = 3000, Rounding = 0, Default = math.floor(Camera.ViewportSize.X-250), Callback = function() end })
ItemFinderGroup:AddSlider("find_y", { Text = "Finder Y Pos", Min = 0, Max = 3000, Rounding = 0, Default = 50, Callback = function() end })

local finder_panel = {}
finder_panel.pos = Vector2.new(50, 50)
finder_panel.width = 200
finder_panel.dragging = false
finder_panel.dragoffset = Vector2.new(0,0)
finder_panel.bg     = cheat.utility.new_drawing("Square",{Visible=false,Filled=true,Color=Color3.fromRGB(20,20,20),ZIndex=100})
finder_panel.border = cheat.utility.new_drawing("Square",{Visible=false,Filled=false,Color=Color3.fromRGB(45,45,45),Thickness=1,ZIndex=101})
finder_panel.title  = cheat.utility.new_drawing("Text",  {Visible=false,Text="Item Finder",Size=16,Center=true,Color=Color3.new(1,1,1),Outline=true,ZIndex=102})
finder_panel.glow = {}
for i=1,6 do finder_panel.glow[i]=cheat.utility.new_drawing("Square",{Visible=false,Filled=false,Thickness=1,ZIndex=99}) end
finder_panel.labels = {}
for i=1,30 do finder_panel.labels[i]=cheat.utility.new_drawing("Text",{Visible=false,Text="",Size=14,Center=true,Color=Color3.fromRGB(200,200,200),Outline=true,ZIndex=102}) end

local last_finder_scan = 0
local finder_cache = {}
local _finder_shown = false

cheat.utility.new_heartbeat(function()
    local enabled = finder_toggle.Value
    if not enabled then
        if _finder_shown then
            finder_panel.bg.Visible=false; finder_panel.border.Visible=false; finder_panel.title.Visible=false
            for i=1,6 do finder_panel.glow[i].Visible=false end
            for i=1,30 do finder_panel.labels[i].Visible=false end
            _finder_shown = false
        end
        return
    end
    _finder_shown = true
    local found_players
    local now3 = tick()
    if now3 - last_finder_scan < 1 then
        found_players = finder_cache
    else
        last_finder_scan = now3
        -- FIX: selected_finder_items — dict из Obsidian, используем прямой lookup
        found_players = {}
        if selected_finder_items and next(selected_finder_items) ~= nil then
            for _,player in ipairs(Players:GetPlayers()) do
                if player~=LocalPlayer then
                    local p_inv = ReplicatedPlayers:FindFirstChild(player.Name) and ReplicatedPlayers[player.Name]:FindFirstChild("Inventory")
                    if p_inv then
                        local found_for_player = {}
                        local function check_item(item)
                            if selected_finder_items[item.Name] and not found_for_player[item.Name] then
                                found_for_player[item.Name]=true
                                table.insert(found_players, player.Name.." ("..item.Name..")")
                            end
                            local sub_inv=item:FindFirstChild("Inventory")
                            if sub_inv then for _,si in ipairs(sub_inv:GetChildren()) do check_item(si) end end
                            local atts=item:FindFirstChild("Attachments")
                            if atts then for _,at in ipairs(atts:GetChildren()) do check_item(at) end end
                        end
                        for _,item in ipairs(p_inv:GetChildren()) do check_item(item) end
                    end
                end
            end
        end
        finder_cache = found_players
    end

    if #found_players>0 then
        finder_panel.bg.Visible=true; finder_panel.border.Visible=true; finder_panel.title.Visible=true
        local max_display=math.min(#found_players,30)
        local h=45+(max_display*16)
        local p=finder_panel.pos
        local size=Vector2.new(finder_panel.width,h)
        local mousepos=Vector2.new(Mouse.X,Mouse.Y+GuiInset.Y)
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local in_bounds=mousepos.X>=p.X and mousepos.X<=p.X+size.X and mousepos.Y>=p.Y and mousepos.Y<=p.Y+size.Y
            if in_bounds or finder_panel.dragging then
                if not finder_panel.dragging then finder_panel.dragging=true; finder_panel.dragoffset=p-mousepos end
                finder_panel.pos=mousepos+finder_panel.dragoffset; p=finder_panel.pos
            end
        else finder_panel.dragging=false end
        finder_panel.bg.Position=p; finder_panel.bg.Size=size
        finder_panel.border.Position=p; finder_panel.border.Size=size
        finder_panel.title.Position=p+Vector2.new(finder_panel.width/2,5)
        local g_color=finder_glow_color; local g_size=finder_glow_size
        for i=1,6 do
            local th=(i/6)*g_size
            finder_panel.glow[i].Visible=true; finder_panel.glow[i].Color=g_color
            finder_panel.glow[i].Thickness=math.max(1,th); finder_panel.glow[i].Transparency=0.3-(i*0.04)
            finder_panel.glow[i].Size=size+Vector2.new(th*2,th*2); finder_panel.glow[i].Position=p-Vector2.new(th,th)
        end
        for i=1,30 do
            if i<=max_display then finder_panel.labels[i].Visible=true; finder_panel.labels[i].Text=found_players[i]; finder_panel.labels[i].Position=p+Vector2.new(finder_panel.width/2,25+(i*15))
            else finder_panel.labels[i].Visible=false end
        end
    else
        finder_panel.bg.Visible=false; finder_panel.border.Visible=false; finder_panel.title.Visible=false
        for i=1,6 do finder_panel.glow[i].Visible=false end
        for i=1,30 do finder_panel.labels[i].Visible=false end
    end
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 12] PLAYER TAB — Movement + Noclip + Bunny Hop + No Fall + Anti Drown
-- ═══════════════════════════════════════════════════════════════════════════
local PlayerGroup = Tabs.Player:AddLeftGroupbox("Movement")
local MovementGroup = Tabs.Player:AddRightGroupbox("Misc Movement")

local speedhack, speedhack_speed = false, 18
local speedhack_autospeed, speedhack_autospeed_offset = false, 3
local flyhack, flyhack_key, flyhack_speed, flyhack_speed_y = false, false, 25, 25
local nc_state = { on = false, key = false, speed = 1, kinds = {"Floors","Walls"}, layers = 1 }
local nc_clipActive = false

-- FIX #2: Speedhack reset на выключение
PlayerGroup:AddToggle("speedhack", {Text = "Speedhack", Default = false, Callback = function(v)
    speedhack = v
    if not v then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16 end
    end
end})
PlayerGroup:AddToggle("speedhack_auto", {Text = "Auto Speed", Default = false, Callback = function(v) speedhack_autospeed = v end})
PlayerGroup:AddSlider("speedhack_speed", {Text = "Speedhack Speed", Min = 1, Max = 24, Rounding = 1, Default = 18, Callback = function(v) speedhack_speed = v end})
PlayerGroup:AddSlider("speedhack_offset", {Text = "Auto Speed Offset", Min = -5, Max = 5, Rounding = 1, Default = 3, Callback = function(v) speedhack_autospeed_offset = v end})

local flyToggle = PlayerGroup:AddToggle("flyhack", {Text = "Flyhack", Default = false, Callback = function(v) flyhack = v end})
flyToggle:AddKeyPicker("flyhack_key", {Default = "X", Text = "Fly Key", Mode = "Toggle", SyncToggleState = false, Callback = function(state) flyhack_key = state end})
PlayerGroup:AddSlider("flyhack_speed", {Text = "Fly Speed", Min = 0, Max = 50, Rounding = 1, Default = 25, Callback = function(v) flyhack_speed = v end})
PlayerGroup:AddSlider("flyhack_speed_y", {Text = "Fly Speed Y", Min = 0, Max = 50, Rounding = 1, Default = 25, Callback = function(v) flyhack_speed_y = v end})

local ncToggle = PlayerGroup:AddToggle("noclip", {Text = "Noclip", Default = false, Callback = function(v)
    nc_state.on = v
    if not v then nc_state.key = false end
end})
ncToggle:AddKeyPicker("noclip_key", {Default = "C", Text = "Noclip Key", Mode = "Toggle", SyncToggleState = false, Callback = function(state)
    nc_state.key = nc_state.on and state
end})
PlayerGroup:AddDropdown("noclip_kinds", {
    Text = "Clip Through",
    Values = {"Floors", "Walls"},
    Default = {"Floors", "Walls"},
    Multi = true,
    Callback = function(v)
        local selected = {}
        if type(v) == "table" then
            for k, val in next, v do
                if type(k) == "string" then
                    if val then table.insert(selected, k) end
                else
                    table.insert(selected, val)
                end
            end
        end
        nc_state.kinds = #selected > 0 and selected or {"Floors", "Walls"}
    end
})
PlayerGroup:AddSlider("noclip_layers", {Text = "Max Layers", Min = 1, Max = 4, Rounding = 0, Default = 1, Callback = function(v) nc_state.layers = math.max(1, math.floor(v)) end})
PlayerGroup:AddSlider("noclip_speed", {Text = "Clip Speed", Min = 0.5, Max = 8, Rounding = 1, Default = 1, Callback = function(v) nc_state.speed = v end})

-- BUNNY HOP / NO FALL / ANTI DROWN
local bhop_enabled = false
local no_fall = false
local anti_drown = false

MovementGroup:AddToggle("bhop_enabled", {Text = "Bunny Hop (Velocity)", Default = false, Callback = function(v) bhop_enabled = v end})
MovementGroup:AddToggle("no_fall", {Text = "No Fall Damage", Default = false, Callback = function(v) no_fall = v end})
MovementGroup:AddToggle("anti_drown", {Text = "Anti Drown", Default = false, Callback = function(v) anti_drown = v end})

-- Anti drown namecall hook
local old_drown_namecall
old_drown_namecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if anti_drown and not checkcaller() and (method == "FireServer" or method == "fireServer") and self.Name == "Drowning" then
        return nil
    end
    return old_drown_namecall(self, ...)
end)

cheat.utility.new_heartbeat(function()
    if anti_drown then
        local rsPlayer = ReplicatedStorage:FindFirstChild("Players") and ReplicatedStorage.Players:FindFirstChild(LocalPlayer.Name)
        if rsPlayer and rsPlayer:FindFirstChild("Status") and rsPlayer.Status:FindFirstChild("GameplayVariables") then
            rsPlayer.Status.GameplayVariables:SetAttribute("Drowning", false)
        end
    end
end)

cheat.utility.new_heartbeat(function()
    if not bhop_enabled then return end
    if not UserInputService:IsKeyDown(Enum.KeyCode.Space) then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp and hum.Health > 0 then
        if hum.FloorMaterial ~= Enum.Material.Air then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, 22, hrp.Velocity.Z)
        end
    end
end)

cheat.utility.new_heartbeat(function()
    if not no_fall then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        if hum:GetState() == Enum.HumanoidStateType.Freefall then
            if hrp.AssemblyLinearVelocity.Y < -12.5 then
                hum:ChangeState(Enum.HumanoidStateType.Landed)
            end
        end
    end
end)

local function sw_calculate_speed(hrp)
    local external_mod = hrp:GetAttribute("MovementModifier") or 0
    local total_mod = math.clamp(external_mod, -10, 0)
    return 18.2 + total_mod
end

cheat.utility.new_renderstepped(function(delta)
    if not speedhack and not flyhack then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end

    local cameralook = (Vector3.new(1, 0, 1) * Camera.CFrame.LookVector).Unit
    local direction = Vector3.new(0, 0, 0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then direction = direction + cameralook end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then direction = direction - cameralook end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then direction = direction + Vector3.new(-cameralook.Z, 0, cameralook.X) end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then direction = direction + Vector3.new(cameralook.Z, 0, -cameralook.X) end
    if direction ~= Vector3.zero then direction = direction.Unit end

    local calcspeed = speedhack_autospeed and (sw_calculate_speed(hrp) + speedhack_autospeed_offset) or speedhack_speed

    if speedhack then hum.WalkSpeed = calcspeed end

    if flyhack and flyhack_key then
        local ydir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ydir = ydir + Vector3.yAxis end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then ydir = ydir - Vector3.yAxis end
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.CFrame = hrp.CFrame + (Vector3.new(1, 0, 1) * direction * flyhack_speed * delta + flyhack_speed_y * ydir * delta)
    elseif speedhack then
        local hmm = direction * calcspeed
        hrp.AssemblyLinearVelocity = Vector3.new(hmm.X, hrp.AssemblyLinearVelocity.Y, hmm.Z)
    end
end)

-- Noclip (swim port)
do
    local NC_PROBE_WAIT = 0.05
    local NC_SINK = 0.35
    local NC_RISE = 0.25
    local NC_REACH = 3
    local NC_MAXDROP = 6
    local NC_DROP_SEARCH = 10
    local NC_DWELL = 0.25
    local NC_HELD_DIST = 4
    local NC_HELD_TIME = 4
    local NC_WALL_ROT = CFrame.Angles(math.pi / 2, 0, 0)
    local NC_OK = Color3.fromRGB(130, 255, 170)
    local NC_BAD = Color3.fromRGB(255, 93, 120)
    local NC_MID = Color3.fromRGB(255, 210, 120)
    local NC_IDLE = Color3.fromRGB(210, 210, 210)

    local function nc_rig()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        local hm = c and c:FindFirstChildOfClass("Humanoid")
        return c, h, hm
    end

    local function nc_uac_pos()
        local data = ReplicatedPlayers:FindFirstChild(LocalPlayer.Name)
        local status = data and data:FindFirstChild("Status")
        local uac = status and status:FindFirstChild("UAC")
        local pos = uac and uac:GetAttribute("LastVerifiedPos")
        if typeof(pos) == "Vector3" then return pos end
        return nil
    end

    local nc_ray = RaycastParams.new()
    nc_ray.FilterType = Enum.RaycastFilterType.Exclude
    nc_ray.IgnoreWater = true
    pcall(function() nc_ray.RespectCanCollide = true end)

    local nc_over = OverlapParams.new()
    nc_over.FilterType = Enum.RaycastFilterType.Exclude
    pcall(function() nc_over.RespectCanCollide = true end)

    local function nc_filter(char)
        nc_ray.FilterDescendantsInstances = {char, Workspace:FindFirstChild("NoCollision"), Workspace:FindFirstChild("DroppedItems")}
    end

    local nc_probe_part = Instance.new("Part")
    nc_probe_part.Name = "NoclipProbe"
    nc_probe_part.Anchored = true
    nc_probe_part.CanCollide = false
    nc_probe_part.CanTouch = false
    nc_probe_part.CanQuery = false
    nc_probe_part.CastShadow = false
    nc_probe_part.Transparency = 1
    nc_probe_part.Size = Vector3.new(1, 1, 1)
    nc_probe_part.Parent = Workspace.Terrain

    local nc_old_gui = game:GetService("CoreGui"):FindFirstChild("ZalupaNoclip")
    if nc_old_gui then nc_old_gui:Destroy() end
    local nc_gui = Instance.new("ScreenGui")
    nc_gui.Name = "ZalupaNoclip"
    nc_gui.ResetOnSpawn = false
    nc_gui.IgnoreGuiInset = true
    nc_gui.DisplayOrder = 10
    nc_gui.Parent = game:GetService("CoreGui")

    local nc_label = Instance.new("TextLabel")
    nc_label.AnchorPoint = Vector2.new(0.5, 0)
    nc_label.Position = UDim2.new(0.5, 0, 0.5, 24)
    nc_label.Size = UDim2.fromOffset(300, 14)
    nc_label.BackgroundTransparency = 1
    nc_label.Font = Enum.Font.Gotham
    nc_label.TextSize = 12
    nc_label.TextStrokeTransparency = 0.35
    nc_label.TextColor3 = NC_IDLE
    nc_label.Text = ""
    nc_label.Visible = false
    nc_label.Parent = nc_gui

    local nc_clip, nc_plan, nc_last_part, nc_part_time, nc_cooling, nc_cool_until = nil, nil, nil, 0, false, 0

    local function nc_kind_allowed(kind)
        if type(nc_state.kinds) ~= "table" then return true end
        return table.find(nc_state.kinds, kind) ~= nil
    end

    local function nc_dims(char, hrp, hum)
        local feet = hum.HipHeight > 0 and hum.HipHeight + hrp.Size.Y / 2 or 3
        local head = char and char:FindFirstChild("Head")
        local neck, top = 1, 6
        if head and head:IsA("BasePart") then
            local y = hrp.CFrame:PointToObjectSpace(head.Position).Y
            neck = y - head.Size.Y / 2
            top = y + head.Size.Y / 2
        end
        return feet, math.max(0.2, neck), math.max(neck + 0.5, top)
    end

    local function nc_cf_at(plan, d)
        return CFrame.new(plan.surf + plan.n * d) * plan.rot
    end

    local function nc_snap_ground(char, hrp, feet)
        if not (hrp and hrp.Parent) then return end
        if char then nc_filter(char) end
        local p = hrp.Position
        local hit = Workspace:Raycast(p + Vector3.new(0, 1, 0), Vector3.new(0, -256, 0), nc_ray)
        if not hit then return end
        local drop = p.Y - hit.Position.Y + feet
        if drop > 0.05 then hrp.CFrame = hrp.CFrame - Vector3.new(0, drop, 0) end
    end

    local function nc_finish(mode, msg)
        local c = nc_clip
        if not c then return end
        nc_clip = nil
        nc_clipActive = false
        local char, hrp = nc_rig()
        if hrp and hrp.Parent then
            pcall(function()
                if mode == "back" then hrp.CFrame = c.start
                elseif mode == "finish" then hrp.CFrame = c.kind == "floor" and nc_cf_at(c, c.uEnd) or c.final end
                local done = mode ~= "back" and (mode == "finish" or (c.phase or 0) >= 2)
                if done then
                    nc_snap_ground(char, hrp, c.feet or 3)
                    local cf = hrp.CFrame
                    local lv = cf.LookVector
                    local flat = Vector3.new(lv.X, 0, lv.Z)
                    if flat.Magnitude < 0.001 then flat = cf.RightVector end
                    hrp.CFrame = CFrame.lookAt(cf.Position, cf.Position + flat.Unit)
                end
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        for _, p in c.parts do if p.Parent then pcall(function() p.CanCollide = true end) end end
        if c.hum and c.hum.Parent then pcall(function() c.hum.PlatformStand = c.stood == true end) end
        nc_cooling = true
        nc_cool_until = os.clock() + 0.75
        nc_plan = nil
        if msg then pcall(function() Library:Notify({Title = "Noclip", Description = msg, Time = 3}) end) end
    end

    RunService.Heartbeat:Connect(function()
        if not nc_state.on then return end
        local char, hrp, hum = nc_rig()
        nc_label.Visible = nc_state.key and char ~= nil
        if nc_clip then
            local c = nc_clip
            if c.hum ~= hum then nc_finish(nil) end
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        nc_clip = nil
        nc_plan = nil
        nc_last_part = nil
        nc_clipActive = false
    end)
end

