local fovCircle = Drawing.new("Circle")
fovCircle.Thickness = 1.5; fovCircle.NumSides = 60
fovCircle.Color = Color3.new(1,1,1); fovCircle.Transparency = 0.4; fovCircle.Filled = false
fovCircle.Visible = false

local function get_gun(player)
    local P = ReplicatedPlayers:FindFirstChild(player.Name)
    if P and P:FindFirstChild("Status") and P.Status:FindFirstChild("GameplayVariables")
        and P.Status.GameplayVariables:FindFirstChild("EquippedTool") and P.Status.GameplayVariables.EquippedTool.Value then
        return tostring(P.Status.GameplayVariables.EquippedTool.Value)
    end
    return "None"
end

-- FIX #3: position.Z > 0 проверка (за камерой)
local function get_closest_target(usefov, fov_size, aimpart, npc, target_heli, require_triggerable, allow_manip, manip_origin)
    aimpart = aimpart or silent_aim.part or "Head"
    usefov = usefov ~= nil and usefov or silent_aim.fov
    fov_size = fov_size or silent_aim.fov_size or 100
    npc = npc ~= nil and npc or silent_aim.target_npc
    local heli = target_heli ~= nil and target_heli or silent_aim.target_heli
    allow_manip = allow_manip ~= nil and allow_manip or silent_aim.corner_shoot
    manip_origin = manip_origin ~= nil and manip_origin or silent_aim.manipulated_origin

    local ermm_part, isnpc = nil, false
    local maximum_distance = usefov and fov_size or math.huge
    local mousepos = Vector2.new(Mouse.X, Mouse.Y)

    local function is_triggerable(parent, part)
        local char = LocalPlayer.Character
        local vp = RaycastParams.new()
        vp.FilterType = Enum.RaycastFilterType.Exclude
        vp.FilterDescendantsInstances = { get_nocollision(), Camera, char }
        local cast = Workspace:Raycast(Camera.CFrame.p, part.Position - Camera.CFrame.p, vp)
        if not cast or (cast.Instance and cast.Instance:IsDescendantOf(parent)) then return true end
        if allow_manip and manip_origin then
            vp.FilterDescendantsInstances = { LocalPlayer.Character, Camera, get_nocollision() }
            local res = Workspace:Raycast(manip_origin, part.Position - manip_origin, vp)
            if not res or (res.Instance and res.Instance:IsDescendantOf(parent)) then return true end
        end
        return false
    end

    if npc then
        local aiZones = Workspace:FindFirstChild("AiZones")
        if aiZones then
            for _, zone in pairs(aiZones:GetChildren()) do
                for _, npcs in pairs(zone:GetChildren()) do
                    local part = npcs:FindFirstChild(aimpart)
                    local is_heli = false
                    if heli and (npcs.Name == "MI24V" or npcs.Name == "BTR80") then
                        is_heli = true
                        part = npcs:FindFirstChild("CollisionPilot", true) or npcs:FindFirstChild("Mi24_Prop_M", true)
                    end
                    if not is_heli and (npcs.Name == "MI24V" or npcs.Name == "BTR80") then continue end
                    local humanoid = npcs:FindFirstChildOfClass("Humanoid")
                    if part and (is_heli or (humanoid and humanoid.Health > 0)) then
                        if (Camera.CFrame.p - part.Position).Magnitude < 2500 then
                            local position, onscreen = Camera:WorldToViewportPoint(part.Position)
                            -- FIX #3: проверяем Z > 0 (не за камерой)
                            if position.Z > 0 then
                                local distance = (Vector2.new(position.X, position.Y - GuiInset.Y) - mousepos).Magnitude
                                if (usefov and onscreen or not usefov) and distance < maximum_distance then
                                    if require_triggerable then
                                        if is_triggerable(npcs, part) then ermm_part = part; maximum_distance = distance; isnpc = true end
                                    else
                                        ermm_part = part; maximum_distance = distance; isnpc = true
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    for _, plr in Players:GetPlayers() do
        local character = plr.Character
        if plr ~= LocalPlayer and character then
            local part = character:FindFirstChild(aimpart)
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if part and humanoid and humanoid.Health > 0 then
                local position, onscreen = Camera:WorldToViewportPoint(part.Position)
                -- FIX #3: проверяем Z > 0
                if position.Z > 0 then
                    local distance = (Vector2.new(position.X, position.Y - GuiInset.Y) - mousepos).Magnitude
                    if (usefov and onscreen or not usefov) and distance <= maximum_distance then
                        if require_triggerable then
                            if is_triggerable(character, part) then ermm_part = part; maximum_distance = distance; isnpc = false end
                        else
                            ermm_part = part; maximum_distance = distance; isnpc = false
                        end
                    end
                end
            end
        end
    end
    return ermm_part, isnpc
end

local shoot_debounce = tick()
cheat.shoot_weapon_packet = nil

task.spawn(function()
    local Remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 10)
    if not Remotes then return end
    local ProjectileInflict = Remotes:WaitForChild("ProjectileInflict", 10)
    local FireProjectile    = Remotes:WaitForChild("FireProjectile", 10)
    if not (ProjectileInflict and FireProjectile) then return end

    cheat.shoot_weapon_packet = function(isvis, speedmult)
        speedmult = speedmult or shootspeed
        local weapon = get_gun(LocalPlayer)
        if weapon == "None" then return end
        local rpinv = ReplicatedPlayers:FindFirstChild(LocalPlayer.Name) and ReplicatedPlayers[LocalPlayer.Name]:FindFirstChild("Inventory")
        local inv_weapon = rpinv and rpinv:FindFirstChild(weapon)
        local aimpart = Camera:FindFirstChild("ViewModel") and Camera.ViewModel:FindFirstChild("AimPart")
        if not (inv_weapon and inv_weapon:FindFirstChild("SettingsModule")) then return end
        local ok_req, weapon_settings = pcall(require, inv_weapon:FindFirstChild("SettingsModule"))
        if not ok_req or not rawget(weapon_settings, "FireRate") or shoot_debounce > tick() then return end

        local real_orig = Camera.CFrame.p
        if silent_aim.corner_shoot and silent_aim.manipulated_origin then
            real_orig = silent_aim.manipulated_origin
        end
        local _fire_part = silent_aim.target_part
        local _fire_pos  = _fire_part and _fire_part.Position or nil
        local dist = _fire_pos and (_fire_pos - real_orig).Magnitude or 0
        local autoshootdelay = tick() - (dist / 1000)
        local rnd = math.random(-10000, 10000)
        silent_aim._exact_fire_tick = tick()
        local as_dir = _fire_pos and (_fire_pos - real_orig).Unit or Vector3.new(0,1,0)

        local ok_inv, fire_ok = pcall(function() return FireProjectile:InvokeServer(as_dir, rnd, autoshootdelay) end)
        if ok_inv then
            pcall(function()
                ProjectileInflict:FireServer(
                    _fire_part,
                    _fire_part.CFrame:ToObjectSpace(CFrame.new(0, 0.0001, 0)),
                    rnd, tick()
                )
            end)
            if silent_aim.tracer then
                local t_orig = real_orig
                if not (silent_aim.corner_shoot and silent_aim.manipulated_origin) then
                    t_orig = aimpart and aimpart.Position or Camera.CFrame.p
                end
                spawn_tracer(t_orig, _fire_pos or Vector3.zero, true)
            end
            if hit_effect_enabled and _fire_pos then
                spawn_hit_effect(_fire_pos)
            end
        end
        -- FIX #6: shootspeed — делим на speedmult (было умножение → медленнее)
        shoot_debounce = tick() + (rawget(weapon_settings, "FireRate") / speedmult)
    end
end)

local corner_shoot_params = RaycastParams.new()
corner_shoot_params.FilterType = Enum.RaycastFilterType.Exclude
local corner_shoot_filter = {nil, nil, nil}

cheat.utility.new_heartbeat(function(delta)
    if not (silent_aim.enabled or silent_aim.triggerbot or packetautoshoot) then
        silent_aim.target_part = nil
        silent_aim.isvisible = false
        fovCircle.Visible = false
        if silent_aim._trigger_held then
            silent_aim._trigger_held = false
            if mouse1release then mouse1release() end
        end
        return
    end

    local mouse_pos = Vector2.new(Mouse.X, Mouse.Y)

    silent_aim.target_part, silent_aim.is_npc = get_closest_target(silent_aim.fov, silent_aim.fov_size, silent_aim.part, silent_aim.target_npc, silent_aim.target_heli)

    silent_aim.manipulated = false
    local old_origin = silent_aim.manipulated_origin
    silent_aim.manipulated_origin = nil

    if silent_aim.target_part then
        if silent_aim.corner_shoot then
            local hitpart = silent_aim.target_part
            local base_pos = Camera.CFrame.Position
            local target_pos = hitpart.Position
            corner_shoot_filter[1] = LocalPlayer.Character
            corner_shoot_filter[2] = Camera
            corner_shoot_filter[3] = get_nocollision()
            corner_shoot_params.FilterDescendantsInstances = corner_shoot_filter
            local res = Workspace:Raycast(base_pos, target_pos - base_pos, corner_shoot_params)
            if not res or (res.Instance and res.Instance:IsDescendantOf(hitpart.Parent)) then
                silent_aim.isvisible = true
            else
                silent_aim.isvisible = false
                if old_origin then
                    silent_aim.manipulated_origin = old_origin
                    silent_aim.manipulated = true
                else
                    local found_origin = nil
                    local max_dist = silent_aim.corner_shoot_dist
                    local cam_cf = Camera.CFrame
                    local to_target_dir = (target_pos - base_pos).Unit
                    local right = cam_cf.RightVector
                    local up    = cam_cf.UpVector
                    local dirs = { right, -right, up, -up,
                        (right + up).Unit, (-right + up).Unit,
                        (right - up).Unit, (-right - up).Unit,
                        (right + to_target_dir).Unit, (-right + to_target_dir).Unit }
                    table.sort(dirs, function(a, b) return a:Dot(to_target_dir) > b:Dot(to_target_dir) end)
                    local char_model = hitpart.Parent
                    for d = 1, max_dist, 1 do
                        for _di = 1, #dirs do
                            local dir = dirs[_di]
                            local offset = dir * d
                            local origin = base_pos + offset
                            if not Workspace:Raycast(base_pos, offset, corner_shoot_params) then
                                local r = Workspace:Raycast(origin, target_pos - origin, corner_shoot_params)
                                if not r or (r.Instance and r.Instance:IsDescendantOf(char_model)) then
                                    local buf_offset = dir * (d + 1.5)
                                    local buf_origin = base_pos + buf_offset
                                    if not Workspace:Raycast(base_pos, buf_offset, corner_shoot_params) then
                                        local br = Workspace:Raycast(buf_origin, target_pos - buf_origin, corner_shoot_params)
                                        if not br or (br.Instance and br.Instance:IsDescendantOf(char_model)) then
                                            found_origin = buf_origin; break
                                        end
                                    end
                                    if not found_origin then found_origin = origin; break end
                                end
                            end
                        end
                        if found_origin then break end
                    end
                    if found_origin then
                        silent_aim.manipulated = true
                        silent_aim.manipulated_origin = found_origin
                    end
                end
            end
        else
            local vp = RaycastParams.new()
            vp.FilterType = Enum.RaycastFilterType.Exclude
            vp.FilterDescendantsInstances = { get_nocollision(), Camera, LocalPlayer.Character }
            local cast = Workspace:Raycast(Camera.CFrame.p, silent_aim.target_part.Position - Camera.CFrame.p, vp)
            silent_aim.isvisible = (not cast or (cast.Instance and cast.Instance:IsDescendantOf(silent_aim.target_part.Parent)))
        end
    else
        silent_aim.isvisible = false
    end

    fovCircle.Position = mouse_pos
    fovCircle.Radius = silent_aim.fov_size
    fovCircle.Visible = silent_aim.fov_show and silent_aim.enabled

    if packetautoshoot and silent_aim.target_part and cheat.shoot_weapon_packet then
        pcall(cheat.shoot_weapon_packet, silent_aim.isvisible, shootspeed)
    end

    local triggerable = silent_aim.isvisible
    if silent_aim.triggerbot_manipulation and silent_aim.manipulated_origin ~= nil then
        triggerable = true
    end
    if silent_aim.triggerbot and not triggerable then
        local alt_part, alt_npc = get_closest_target(silent_aim.fov, silent_aim.fov_size, silent_aim.part, silent_aim.target_npc, silent_aim.target_heli, true, silent_aim.triggerbot_manipulation, silent_aim.manipulated_origin)
        if alt_part then
            silent_aim.target_part = alt_part
            silent_aim.is_npc = alt_npc
            triggerable = true
        end
    end

    if silent_aim.triggerbot and silent_aim.target_part and triggerable then
        if not silent_aim._trigger_held then
            silent_aim._trigger_held = true
            if mouse1press then mouse1press() end
        end
    else
        if silent_aim._trigger_held then
            silent_aim._trigger_held = false
            if mouse1release then mouse1release() end
        end
    end
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 15b] __namecall HOOK — Silent Aim + Instant Hit
-- ═══════════════════════════════════════════════════════════════════════════
local __namecall
__namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if checkcaller() then return __namecall(self, ...) end

    if method ~= "GetAttribute" and method ~= "Raycast"
        and method ~= "InvokeServer" and method ~= "invokeServer"
        and method ~= "FireServer" and method ~= "fireServer" then
        return __namecall(self, ...)
    end

    local args = {...}
    local argc = select("#", ...)

    if method == "GetAttribute" then
        local attribute = args[1]
        if silent_aim.nospread and attribute == "AccuracyDeviation" then return 0 end
        if silent_aim.enabled then
            if attribute == "ProjectileDrop" then return 0 end
            if attribute == "Drag" then return 0 end
        end
    end

    -- RAYCAST: подмена результата на hit в target_part (silent aim)
    if method == "Raycast" then
        local origin = args[1]
        if typeof(origin) == "Vector3" and silent_aim.enabled and silent_aim.target_part then
            local hitpart = silent_aim.target_part
            if hitpart and hitpart.Parent then
                if silent_aim.corner_shoot and silent_aim.manipulated_origin then
                    origin = silent_aim.manipulated_origin
                    args[1] = origin
                end
                local direction = hitpart.Position - origin
                args[2] = direction
                return {
                    Instance = hitpart,
                    Position = hitpart.Position,
                    Normal   = direction.Unit * -1,
                    Material = hitpart.Material,
                    Distance = direction.Magnitude
                }
            end
        end
    end

    -- FIREPROJECTILE: silent aim direction + instant hit timestamp
    if (method == "InvokeServer" or method == "invokeServer") and self.Name == "FireProjectile" then
        silent_aim._exact_fire_tick = tick()
        local origin = Workspace.CurrentCamera.CFrame.Position
        local tp = silent_aim.enabled and silent_aim.target_part
        local is_empty = false
        pcall(function()
            local wpn = get_gun(LocalPlayer)
            if wpn == "None" then return end
            local pi = ReplicatedPlayers:FindFirstChild(LocalPlayer.Name) and ReplicatedPlayers[LocalPlayer.Name]:FindFirstChild("Inventory")
            local iw = pi and pi:FindFirstChild(wpn)
            if not (iw and iw:FindFirstChild("Attachments")) then return end
            local mag = iw.Attachments:FindFirstChild("Magazine")
            if not mag then return end
            local sv = mag:FindFirstChildOfClass("StringValue")
            local ip = sv and sv:FindFirstChild("ItemProperties")
            local la = ip and ip:FindFirstChild("LoadedAmmo")
            if la and la:IsA("Folder") and #la:GetChildren() <= 0 then is_empty = true end
        end)
        if not is_empty and tp and tp.Parent then
            if silent_aim.corner_shoot and silent_aim.manipulated_origin then
                origin = silent_aim.manipulated_origin
                args[1] = (tp.Position - origin).Unit
            end
            -- INSTANT HIT: подмена timestamp чтобы пуля прилетела мгновенно
            if silent_aim.instant and args[3] then
                args[3] = tick() - ((tp.Position - origin).Magnitude / 1000)
            end
        end
        setnamecallmethod(method)
        return __namecall(self, unpack(args, 1, argc))
    end

    setnamecallmethod(method)
    return __namecall(self, unpack(args, 1, argc))
end))

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 15c] CreateBullet HOOK — charge shot + tracer + nospread
-- ═══════════════════════════════════════════════════════════════════════════
task.spawn(function()
    local ok_mod, bulletmodule = pcall(require, ReplicatedStorage.Modules.FPS.Bullet)
    if not ok_mod or not bulletmodule then return end
    local old_bullet = bulletmodule.CreateBullet
    local drop_proto, drop_index, drop_applied = nil, nil, false

    local function apply_no_drop()
        if drop_applied or not silent_aim.nospread or not (debug and debug.getconstants and debug.setconstant) then return end
        local function scan(fn, depth)
            if drop_proto or depth > 5 or type(fn) ~= "function" then return end
            local ok, constants = pcall(debug.getconstants, fn)
            if ok and type(constants) == "table" then
                for index, value in constants do
                    if value == -196.2 or value == -9.81 then drop_proto, drop_index = fn, index; return end
                end
            end
            if debug.getproto then
                for index = 1, 8 do
                    local ok_p, proto = pcall(debug.getproto, fn, index)
                    if not ok_p or type(proto) ~= "function" then break end
                    scan(proto, depth + 1)
                    if drop_proto then return end
                end
            end
        end
        for _, v in pairs(bulletmodule) do
            if type(v) == "function" then scan(v, 0); if drop_proto then break end end
        end
        if drop_proto then drop_applied = pcall(debug.setconstant, drop_proto, drop_index, 0) end
    end

    bulletmodule.CreateBullet = function(self, ...)
        local args = {...}
        local argCount = select("#", ...)
        if silent_aim.nospread then apply_no_drop() end

        -- CHARGE SHOT: мультипликация выстрела
        local charged_shots = 1
        if charge_shot_enabled == true and cheat.get_charge_shot_count then
            charged_shots = cheat.get_charge_shot_count()
        end
        if charged_shots > 1 then
            for _ = 2, charged_shots do
                local duplicate_args = table.clone(args)
                task.spawn(function()
                    pcall(old_bullet, self, unpack(duplicate_args, 1, argCount))
                end)
            end
        end

        if silent_aim.enabled and silent_aim.target_part then
            local loadedammo, aimpart_index
            for i, v in pairs(args) do
                if typeof(v) == "Instance" and v.Name == "AimPart" then aimpart_index = i end
                if type(v) == "string" then
                    local tmp = ReplicatedStorage.AmmoTypes:FindFirstChild(v)
                    if tmp then loadedammo = tmp end
                end
            end
            if not (loadedammo and aimpart_index) then
                return old_bullet(self, unpack(args, 1, argCount))
            end

            if silent_aim.tracer then
                local real_orig = Camera.CFrame.p
                if silent_aim.corner_shoot and silent_aim.manipulated_origin then
                    real_orig = silent_aim.manipulated_origin
                end
                local t_orig = (silent_aim.corner_shoot and silent_aim.manipulated_origin)
                    and real_orig or args[aimpart_index].Position
                local t_target = silent_aim.target_part and silent_aim.target_part.Position
                    or args[aimpart_index].CFrame.LookVector * 10000
                spawn_tracer(t_orig, t_target, true)
            end

            if silent_aim.instant then
                return old_bullet(self, unpack(args, 1, argCount))
            end

            local real_aimpart = args[aimpart_index]
            local old_cf = real_aimpart.CFrame
            local fire_origin = (silent_aim.corner_shoot and silent_aim.manipulated_origin)
                and silent_aim.manipulated_origin or real_aimpart.Position
            local aim_dir = (silent_aim.target_part.Position - fire_origin).Unit
            real_aimpart.CFrame = CFrame.new(real_aimpart.Position, real_aimpart.Position + aim_dir)

            local ok_call, ret = pcall(old_bullet, self, unpack(args, 1, argCount))
            real_aimpart.CFrame = old_cf
            if not ok_call then
                warn("[Zalupa.HooK] CreateBullet error:", ret)
                return
            end
            return ret
        end
        return old_bullet(self, unpack(args, 1, argCount))
    end
end)

