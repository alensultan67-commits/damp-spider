-- [BLOCK 14] INSTANT EQUIP + MELEE HOOKS (FIX #1: теперь работает)
-- ═══════════════════════════════════════════════════════════════════════════
Camera.ChildAdded:Connect(function(child)
    if not instant_equip then return end
    if not child:IsA("Model") then return end
    if child.Name:find("ESP") or child.Name:find("Ghost") or child.Name:find("Effect") then return end
    task.spawn(function()
        local iters = 0
        while child.Parent and iters < 500 do
            iters += 1
            local hum = child:FindFirstChildOfClass("Humanoid")
            if hum and hum.Animator then
                for _, track in ipairs(hum.Animator:GetPlayingAnimationTracks()) do
                    if track.Animation and track.Animation.Name == "Equip" then
                        pcall(function()
                            track:AdjustSpeed(15)
                            track.TimePosition = track.Length - 0.01
                        end)
                        return
                    end
                end
            end
            task.wait(0.001)
        end
    end)
end)

local function new_hook(f, newf, usecclosure)
    if usecclosure then
        local old; old = hookfunction(f, newcclosure(function(...) return newf(old, ...) end))
        return old
    else
        local old; old = hookfunction(f, function(...) return newf(old, ...) end)
        return old
    end
end

-- Melee hooks (FIX #1: no_melee_cooldown / melee_reach / melee_reach_dist теперь видны)
task.spawn(function()
    local melee_module
    for _ = 1, 30 do
        local ok, mod = pcall(function()
            local Modules = ReplicatedStorage:FindFirstChild("Modules")
            local FPS = Modules and Modules:FindFirstChild("FPS")
            local Melee = FPS and FPS:FindFirstChild("Melee")
            if not Melee then return nil end
            return require(Melee)
        end)
        if ok and mod then melee_module = mod break end
        task.wait(0.5)
    end
    if not melee_module then
        warn("[Zalupa.HooK] Melee module not loaded, melee hooks skipped")
        return
    end

    -- Hook MeleeWeaponDefault
    local hooked = false
    while not hooked do
        for _, gc in pairs(getgc(true)) do
            if type(gc) == "table"
               and type(rawget(gc, "MeleeWeaponDefault")) == "function"
               and not gc._melee_hooked then
                gc._melee_hooked = true
                local old_melee_def = gc.MeleeWeaponDefault

                new_hook(old_melee_def, function(old, self, ...)
                    if no_melee_cooldown and self then
                        pcall(function()
                            self.useDebounce = false
                            local attack_type = "NormalAttack"
                            if self.altUseCounter == 1 and self.clientAnimationTracks and self.clientAnimationTracks.UseAlt then
                                attack_type = "NormalAttack"
                            end
                            melee_module:StartSwing(self.weapon, self.worldModel, self.viewModel, attack_type, self.SprintStrafe)
                        end)
                    end
                    return old(self, ...)
                end, true)

                hooked = true
                break
            end
        end
        if not hooked then task.wait(1) end
    end

    -- Hook StartSwing for reach
    if melee_module.StartSwing and not melee_module._reach_hooked then
        melee_module._reach_hooked = true
        local old_start_swing = melee_module.StartSwing
        melee_module.StartSwing = function(self, p1, p2, p3, p4, p5, p6)
            if melee_reach then
                pcall(function()
                    local obj =
                        (typeof(p2) == "Instance" and p2:IsA("ObjectValue") and p2.Value) or
                        (typeof(p1) == "Instance" and p1:IsA("ObjectValue") and p1.Value) or
                        (typeof(p2) == "Instance" and p2) or
                        (typeof(p1) == "Instance" and p1)
                    if obj and obj:FindFirstChild("ItemProperties") and obj.ItemProperties:FindFirstChild("Tool") then
                        local tool = obj.ItemProperties.Tool
                        tool:SetAttribute("RangeNormal", 3 + melee_reach_dist)
                        tool:SetAttribute("RangePower",  3 + melee_reach_dist)
                    end
                end)
            end
            return old_start_swing(self, p1, p2, p3, p4, p5, p6)
        end
    end
end)

-- updateClient hook (recoil, spread, bob, instant aim, unlock firemodes, rapid fire)
task.spawn(function()
    local got_that = false
    repeat
        local gc_list = getgc(true)
        for i = 1, #gc_list do
            local gc = gc_list[i]
            if type(gc) == "table" then
                if type(rawget(gc,"shove")) == "function" and type(rawget(gc,"update")) == "function" then
                    new_hook(gc.shove, function(old, ...)
                        if norecoil then pcall(old, ...) return end
                        return old(...)
                    end, true)
                    new_hook(gc.update, function(old, ...)
                        if nobob then return Vector3.zero end
                        return old(...)
                    end, true)
                end
                if rawget(gc, "updateClient") then
                    new_hook(gc.updateClient, function(old, ...)
                        local args = {...}; local argc = select("#", ...)
                        if instantaim then args[1].AimInSpeed = 0; args[1].AimOutSpeed = 0 end
                        if forceauto then
                            local modes = args[1].FireModes
                            local can_auto = true
                            if type(modes) == "table" then can_auto = table.find(modes, "Auto") ~= nil
                            elseif type(modes) == "string" then can_auto = modes:find("Auto") ~= nil end
                            if can_auto then args[1].FireMode = "Auto" end
                        end
                        -- FIX: unlock firemodes
                        if unlock_firemodes and rawget(args[1], "FireModes") then
                            args[1].FireModes = { "Auto", "Semi" }
                        end
                        -- FIX #6: shootspeed inversion — делим, не умножаем
                        if rapid_fire then args[1].FireRate = rapid_fire_delay / shootspeed end
                        return old(unpack(args, 1, argc))
                    end, true)
                    got_that = true
                end
            end
            if i % 300 == 0 then task.wait() end
        end
        if not got_that then task.wait(1) end
    until got_that
end)

