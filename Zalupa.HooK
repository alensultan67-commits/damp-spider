local function preload_sound(id)
    if not id or id == "" then return end
    task.spawn(function()
        local temp = Instance.new("Sound")
        temp.SoundId = id
        pcall(function() game:GetService("ContentProvider"):PreloadAsync({temp}) end)
        temp:Destroy()
    end)
end

SoundGroup:AddToggle("snd_hs_on", { Text = "Custom Hit Sound", Default = false, Callback = function(v) snd_cfg.hs_enabled = v; if v then preload_sound(snd_cfg.hs_id) end end })
SoundGroup:AddDropdown("snd_hs_pick", { Text = "Hit Sound", Values = hitsound_options, Default = "gamesense", Callback = function(v)
    snd_cfg.hs_id = hitsound_ids[v] or snd_cfg.hs_id
    if snd_cfg.hs_enabled then preload_sound(snd_cfg.hs_id) end
end })
SoundGroup:AddSlider("snd_hs_vol", { Text = "Hit Volume", Min = 1, Max = 500, Rounding = 0, Default = 100, Callback = function(v) snd_cfg.hs_vol = v / 100 end })
SoundGroup:AddButton("snd_hs_test", { Text = "Test Hit Sound", Callback = function()
    local s = Instance.new("Sound")
    s.SoundId = snd_cfg.hs_id; s.Volume = snd_cfg.hs_vol
    if snd_cfg.hs_id == MOAN_ID then s.TimePosition = 2 end
    s.Parent = game:GetService("SoundService"); s:Play()
    if snd_cfg.hs_id == MOAN_ID then task.delay(0.9, function() if s and s.Parent then s:Stop() end end) end
    game:GetService("Debris"):AddItem(s, 5)
end })

SoundGroup:AddToggle("snd_gs_on", { Text = "Custom Gun Sound", Default = false, Callback = function(v) snd_cfg.gs_enabled = v; if v then preload_sound(snd_cfg.gs_id) end end })
SoundGroup:AddDropdown("snd_gs_pick", { Text = "Gun Sound", Values = gunsound_options, Default = "minecraft bow", Callback = function(v)
    snd_cfg.gs_id = gunsound_ids[v] or snd_cfg.gs_id
    if snd_cfg.gs_enabled then preload_sound(snd_cfg.gs_id) end
end })
SoundGroup:AddSlider("snd_gs_vol", { Text = "Gun Volume", Min = 1, Max = 500, Rounding = 0, Default = 100, Callback = function(v) snd_cfg.gs_vol = v / 100 end })
SoundGroup:AddButton("snd_gs_test", { Text = "Test Gun Sound", Callback = function()
    local s = Instance.new("Sound")
    s.SoundId = snd_cfg.gs_id; s.Volume = snd_cfg.gs_vol
    s.Parent = game:GetService("SoundService"); s:Play()
    game:GetService("Debris"):AddItem(s, 5)
end })

local hitsound_detect = {["rbxassetid://4585382589"]=true,["rbxassetid://4585351098"]=true,["rbxassetid://4585382046"]=true,["rbxassetid://4585364605"]=true}
local function apply_custom_hitsound(sound)
    if sound:IsA("Sound") and snd_cfg.hs_enabled and hitsound_detect[sound.SoundId] then
        pcall(function()
            sound.SoundId = snd_cfg.hs_id
            sound.Volume  = snd_cfg.hs_vol
            if snd_cfg.hs_id == MOAN_ID then
                sound.TimePosition = 2
                task.delay(0.9, function() if sound and sound.Parent then sound:Stop() end end)
            end
        end)
    end
end

local pg = LocalPlayer:WaitForChild("PlayerGui", 10)
pg.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then child.ChildAdded:Connect(apply_custom_hitsound) end
end)
local existing_maingui = pg:FindFirstChild("MainGui")
if existing_maingui then existing_maingui.ChildAdded:Connect(apply_custom_hitsound) end

local gun_sound_names_set = {FireSound=true, FireFarSound=true, FireSoundSupressed=true}
local function apply_custom_gunsound(inst)
    if not (inst:IsA("Sound") and gun_sound_names_set[inst.Name] and snd_cfg.gs_enabled) then return end
    if not (inst:IsDescendantOf(Camera) or (LocalPlayer.Character and inst:IsDescendantOf(LocalPlayer.Character))) then return end
    pcall(function()
        inst.SoundId = snd_cfg.gs_id
        inst.Volume  = snd_cfg.gs_vol
    end)
end

Camera.DescendantAdded:Connect(apply_custom_gunsound)
LocalPlayer.CharacterAdded:Connect(function(char)
    char.DescendantAdded:Connect(apply_custom_gunsound)
end)
local char = LocalPlayer.Character
if char then
    char.DescendantAdded:Connect(apply_custom_gunsound)
    for _, d in ipairs(char:GetDescendants()) do apply_custom_gunsound(d) end
end
for _, d in ipairs(Camera:GetDescendants()) do apply_custom_gunsound(d) end

-- ═══════════════════════════════════════════════════════════════════════════
-- [BLOCK 08] ESP LIBRARY (FIX #4: dict lookup + next() для пустой проверки)
-- ═══════════════════════════════════════════════════════════════════════════
cheat.EspLibrary = {} do
    local esp_table: any = {}  -- FIX: `: any` чтобы анализатор не считал поля nil
    local ws   = Workspace
    local lplr = Players.LocalPlayer
    local success, coregui = pcall(game.GetService, game, "CoreGui")
    local container = Instance.new("Folder",
        (success and coregui:FindFirstChild("RobloxGui"))
        or lplr:WaitForChild("PlayerGui", 2) or lplr)

    esp_table = {
        __loaded = false,
        main_settings = {
            textSize = 14, textFont = Drawing.Fonts.Monospace,
        },
        settings = {
            enemy = {
                enabled = false, box = false, box_fill = false,
                realname = false, health = false, dist = false,
                weapon = false, skeleton = false,
                dist_outline = false,
                box_color = { Color3.new(1,1,1), 0 },
                box_fill_color = { Color3.new(1,0,0), 0.5 },
                realname_color = { Color3.new(1,1,1), 0 },
                dist_color = { Color3.new(1,1,1), 0 },
                weapon_color = { Color3.new(1,1,1), 0 },
                skeleton_color = { Color3.new(1,1,1), 0 },
                health_color_top    = Color3.new(0,1,0),
                health_color_bottom = Color3.new(1,0,0),
                health_thickness = 2, health_glow_size = 5,
                dist_outline_color = Color3.new(),
                chams = false, chams_visible_only = false,
                chams_fill_color = { Color3.fromRGB(255,255,255), 0.7 },
                chamsoutline_color = { Color3.fromRGB(255,255,255), 0 },
                chams_outline = false, chams_material = "Neon",
                chams_rainbow = false, chams_pulse = false,
                chams_health_reactive = false, chams_visible_split = false,
                chams_occluded_color = { Color3.fromRGB(255,50,50), 0.5 },
                chams_outline_pulse = false, chams_strobe = false,
                chams_intensity = 0.5, chams_saturation = 1.0,
            },
            corpse = {
                enabled = false, name = true, distance = false,
                color = Color3.fromRGB(0,255,0),
                outline = false, outline_color = Color3.new(),
            },
        },
        objectAdded = {},
        objectRemoving = {},
    }

    local loaded_plrs = {}
    local camera = ws.CurrentCamera
    local VERTICES = {
        Vector3.new(-1,-1,-1), Vector3.new(-1,1,-1), Vector3.new(-1,1,1), Vector3.new(-1,-1,1),
        Vector3.new( 1,-1,-1), Vector3.new( 1,1,-1), Vector3.new( 1,1,1), Vector3.new( 1,-1,1),
    }
    local skeleton_order = {
        LeftFoot="LeftLowerLeg", LeftLowerLeg="LeftUpperLeg", LeftUpperLeg="LowerTorso",
        RightFoot="RightLowerLeg", RightLowerLeg="RightUpperLeg", RightUpperLeg="LowerTorso",
        LeftHand="LeftLowerArm", LeftLowerArm="LeftUpperArm", LeftUpperArm="UpperTorso",
        RightHand="RightLowerArm", RightLowerArm="RightUpperArm", RightUpperArm="UpperTorso",
        LowerTorso="UpperTorso", UpperTorso="Head",
    }

    local function create_obj(kind, args)
        local o = Drawing.new(kind)
        for i,v in args do o[i] = v end
        return o
    end
    local function isBodyPart(name)
        return name=="Head" or name:find("Torso") or name:find("Leg") or name:find("Arm")
            or name:find("Mi24") or name:find("Prop_") or name:find("Hull")
            or name:find("BTR") or name:find("Pilot")
    end

    local function getBoundingBox(parts)
        local minX, minY, minZ = 1e9, 1e9, 1e9
        local maxX, maxY, maxZ = -1e9, -1e9, -1e9
        for i=1,#parts do
            local part = parts[i]
            local cf, sz = part.CFrame, part.Size
            local p1 = (cf - sz*0.5).Position
            local p2 = (cf + sz*0.5).Position
            minX = math.min(minX, p1.X, p2.X); minY = math.min(minY, p1.Y, p2.Y); minZ = math.min(minZ, p1.Z, p2.Z)
            maxX = math.max(maxX, p1.X, p2.X); maxY = math.max(maxY, p1.Y, p2.Y); maxZ = math.max(maxZ, p1.Z, p2.Z)
        end
        local min = Vector3.new(minX, minY, minZ)
        local max = Vector3.new(maxX, maxY, maxZ)
        local center = (min + max) * 0.5
        return CFrame.new(center, Vector3.new(center.X, center.Y, max.Z)), max - min
    end

    local function worldToScreen(world)
        local s, ib = camera:WorldToViewportPoint(world)
        return Vector2.new(s.X, s.Y), ib, s.Z
    end
    local function calculateCorners(cf, sz)
        local c = table.create(#VERTICES)
        for i=1,#VERTICES do
            c[i] = worldToScreen((cf + sz*0.5*VERTICES[i]).Position)
        end
        local mnX, mnY = 1e9, 1e9
        local mxX, mxY = -1e9, -1e9
        for _, v in ipairs(c) do
            if v.X < mnX then mnX = v.X end
            if v.Y < mnY then mnY = v.Y end
            if v.X > mxX then mxX = v.X end
            if v.Y > mxY then mxY = v.Y end
        end
        return {
            corners = c,
            topLeft     = Vector2.new(math.floor(mnX), math.floor(mnY)),
            topRight    = Vector2.new(math.floor(mxX), math.floor(mnY)),
            bottomLeft  = Vector2.new(math.floor(mnX), math.floor(mxY)),
            bottomRight = Vector2.new(math.floor(mxX), math.floor(mxY)),
        }
    end
    local function get_mainpart(model, mn)
        if mn == "corpse" then return model:FindFirstChild("UpperTorso") end
        return nil  -- FIX: explicit return nil (ImplicitReturn warning)
    end
    local function identify_model(model, mn)
        if not model then return false end
        if mn == "corpse" and model:FindFirstChildOfClass("Humanoid") then
            return model.Name.."'s corpse"
        end
        return false
    end

    local _esp_acc = 0
    local _esp_update = true
    cheat.utility.new_renderstepped(function(delta)
        _esp_acc = _esp_acc + delta
        if _esp_acc >= 1/30 then
            _esp_acc = 0
            _esp_update = true
        else
            _esp_update = false
        end
    end)

    local function create_esp(player, isnpc)
        if not player then return end
        if player.ClassName == "Model" then isnpc = true end
        loaded_plrs[player] = {
            obj = {
                box_fill   = create_obj("Square", { Filled=true,  Visible=false }),
                box        = create_obj("Square", { Filled=false, Thickness=1, Visible=false }),
                realname   = create_obj("Text",   { Center=true, Visible=false, Text=player.Name }),
                healthtext = create_obj("Text",   { Center=false, Visible=false }),
                health_bar_cap_top    = create_obj("Circle", { Visible=false, Filled=true, ZIndex=2 }),
                health_bar_cap_bottom = create_obj("Circle", { Visible=false, Filled=true, ZIndex=2 }),
                dist       = create_obj("Text", { Center=true, Visible=false }),
                weapon     = create_obj("Text", { Center=true, Visible=false }),
            },
            chams_object = Instance.new("Highlight", container),
            chams_active = false,
            chams_original = {},
            last_chams_update = 0,
            plr_instance = player,
        }
        for k in next, skeleton_order do
            loaded_plrs[player].obj["skeleton_"..k] = create_obj("Line", { Visible=false })
        end
        for i=1,10 do
            loaded_plrs[player].obj["health_bar_"..i] = create_obj("Line", { Visible=false, Thickness=2, ZIndex=2 })
        end
        for i=1,6 do
            loaded_plrs[player].obj["health_bar_glow_"..i]           = create_obj("Line",   { Visible=false, ZIndex=1 })
            loaded_plrs[player].obj["health_bar_glow_cap_top_"..i]   = create_obj("Circle", { Visible=false, Filled=true, ZIndex=1 })
            loaded_plrs[player].obj["health_bar_glow_cap_bottom_"..i]= create_obj("Circle", { Visible=false, Filled=true, ZIndex=1 })
        end

        local plr = loaded_plrs[player]
        local obj = plr.obj
        local box, box_fill = obj.box, obj.box_fill
        local healthtext, realname, dist, weapon = obj.healthtext, obj.realname, obj.dist, obj.weapon
        local cham = plr.chams_object
        local settings      = esp_table.settings.enemy
        local main_settings = esp_table.main_settings
        local setvis_cache = false

        function plr:forceupdate()
            local isWireframe = settings.chams_material == "Wireframe"
            cham.DepthMode         = settings.chams_visible_only and 1 or 0
            cham.FillColor         = settings.chams_fill_color[1]
            cham.FillTransparency  = isWireframe and 1 or settings.chams_fill_color[2]
            cham.OutlineColor      = settings.chamsoutline_color[1]
            cham.OutlineTransparency = settings.chams_outline and settings.chamsoutline_color[2] or 1
            box.Color, box.Transparency = settings.box_color[1], settings.box_color[2]
            box_fill.Color, box_fill.Transparency = settings.box_fill_color[1], settings.box_fill_color[2]
            realname.Size, realname.Font = main_settings.textSize, main_settings.textFont
            realname.Color = settings.realname_color[1]
            realname.Outline, realname.OutlineColor = settings.dist_outline, settings.dist_outline_color
            dist.Size, dist.Font = main_settings.textSize, main_settings.textFont
            dist.Color = settings.dist_color[1]
            dist.Outline, dist.OutlineColor = settings.dist_outline, settings.dist_outline_color
            weapon.Size, weapon.Font = main_settings.textSize, main_settings.textFont
            weapon.Color = settings.weapon_color[1]
            weapon.Outline, weapon.OutlineColor = settings.dist_outline, settings.dist_outline_color
            for k in next, skeleton_order do
                local sk = obj["skeleton_"..k]
                if sk then sk.Color, sk.Transparency = settings.skeleton_color[1], settings.skeleton_color[2] end
            end
            for i=1,10 do
                if obj["health_bar_"..i] then obj["health_bar_"..i].Thickness = settings.health_thickness end
            end
        end

        function plr:togglevis(bool)
            if setvis_cache == bool then return end
            setvis_cache = bool
            if not bool then
                for _, v in obj do v.Visible = false end
                cham.Enabled = false
                return
            end
            cham.Enabled = settings.chams
            box.Visible       = settings.box
            box_fill.Visible  = settings.box_fill
            realname.Visible  = settings.realname
            healthtext.Visible = false
            obj.health_bar_cap_top.Visible    = settings.health
            obj.health_bar_cap_bottom.Visible = settings.health
            for i=1,6 do
                obj["health_bar_glow_"..i].Visible            = settings.health
                obj["health_bar_glow_cap_top_"..i].Visible    = settings.health
                obj["health_bar_glow_cap_bottom_"..i].Visible = settings.health
            end
            for i=1,10 do obj["health_bar_"..i].Visible = settings.health end
            dist.Visible   = settings.dist
            weapon.Visible = settings.weapon
            for k in next, skeleton_order do
                obj["skeleton_"..k].Visible = settings.skeleton
            end
        end

        plr.connection = cheat.utility.new_renderstepped(function(delta)
            if not _esp_update then return end
            local plr = loaded_plrs[player]
            if not plr then return end
            if not settings.enabled then return plr:togglevis(false) end
            local character = isnpc and player or (not isnpc and player.Character)
            local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
            local head      = character and character:FindFirstChild("Head")
            local is_heli = isnpc and character and (character.Name=="MI24V" or character.Name=="BTR80")
            if is_heli then
                head = character:FindFirstChild("CollisionPilot", true) or character:FindFirstChild("Mi24_Prop_M", true)
                humanoid = humanoid or { Health=character:GetAttribute("Health") or 1000, MaxHealth=1000, Parent=character }
            end
            if not (character and head and humanoid and character.Parent and (head.Parent or is_heli) and (humanoid.Parent or is_heli)) then
                realname.Visible = false
                return plr:togglevis(false)
            end
            local _, onScreen = camera:WorldToViewportPoint(head.Position)
            if not onScreen then return plr:togglevis(false) end
            local dist3d = (camera.CFrame.p - head.Position).Magnitude
            local health = humanoid.Health
            if health <= 0 then return plr:togglevis(false) end
            local maxhealth = humanoid.MaxHealth

            if plr.last_character ~= character then
                plr.last_character = character
                plr.body_parts = {}
                plr._skel_parts = nil
                local check_desc = isnpc and (character.Name=="MI24V" or character.Name=="BTR80")
                for _, part in (check_desc and character:GetDescendants() or character:GetChildren()) do
                    if part:IsA("BasePart") and isBodyPart(part.Name) then
                        plr.body_parts[#plr.body_parts+1] = part
                    end
                end
            end
            if not plr.body_parts or #plr.body_parts <= 0 then return plr:togglevis(false) end
            local corners = calculateCorners(getBoundingBox(plr.body_parts))
            plr:togglevis(true)
            cham.Adornee = character

            box.Position      = corners.topLeft
            box.Size          = corners.bottomRight - corners.topLeft
            box_fill.Position = corners.topLeft
            box_fill.Size     = corners.bottomRight - corners.topLeft

            local healthbar_top_y = corners.topLeft.Y
            if (corners.bottomLeft.Y - corners.topLeft.Y) < 5 then
                healthbar_top_y = corners.bottomLeft.Y - 5
            end
            local top_text_y = math.min(corners.topLeft.Y, healthbar_top_y)
            realname.Position = Vector2.new((corners.topLeft.X+corners.topRight.X)*0.5, top_text_y) - Vector2.yAxis - (Vector2.yAxis * realname.TextBounds.Y) - Vector2.new(0,2)
            realname.Text = player.Name

            dist.Text     = math.round(dist3d/3).." meters"
            dist.Position = (corners.bottomLeft + corners.bottomRight) * 0.5
            local _cl = os.clock()
            if not plr._gun_cache_time or (_cl - plr._gun_cache_time) > 0.5 then
                plr._gun_cache_time = _cl
                plr._gun_cache_text = isnpc and "" or esp_table.get_gun(player)
            end
            weapon.Text = plr._gun_cache_text or ""
            weapon.Position = dist.Position + (dist.Visible and Vector2.yAxis * dist.TextBounds.Y - Vector2.new(0,2) or Vector2.zero)

            healthtext.Visible = false
            local hp = math.clamp(health/maxhealth, 0, 1)
            local bar_start = corners.bottomLeft - Vector2.new(6,0)
            local bar_end   = corners.topLeft    - Vector2.new(6,0)
            if (bar_start.Y - bar_end.Y) < 5 then bar_end = bar_start - Vector2.new(0,5) end
            local gc = settings.health_color_top:Lerp(settings.health_color_bottom, 0.5)
            for i=1,6 do
                local glow = obj["health_bar_glow_"..i]
                local ct, cb = obj["health_bar_glow_cap_top_"..i], obj["health_bar_glow_cap_bottom_"..i]
                if settings.health and hp > 0 then
                    local th = (i/6) * settings.health_glow_size
                    local tr = 0.3 - (i*0.04)
                    glow.Visible, glow.From, glow.To = true, bar_start, bar_start:Lerp(bar_end, hp)
                    glow.Color, glow.Thickness, glow.Transparency = gc, th, tr
                    ct.Visible, ct.Position, ct.Color, ct.Radius, ct.Transparency = true, bar_start:Lerp(bar_end, hp), gc, th/2, tr
                    cb.Visible, cb.Position, cb.Color, cb.Radius, cb.Transparency = true, bar_start, gc, th/2, tr
                else
                    glow.Visible, ct.Visible, cb.Visible = false, false, false
                end
            end
            if settings.health and hp > 0 then
                obj.health_bar_cap_top.Visible    = true
                obj.health_bar_cap_top.Position   = bar_start:Lerp(bar_end, hp)
                obj.health_bar_cap_top.Color      = settings.health_color_top:Lerp(settings.health_color_bottom, 1-hp)
                obj.health_bar_cap_top.Radius     = settings.health_thickness/2
                obj.health_bar_cap_bottom.Visible = true
                obj.health_bar_cap_bottom.Position= bar_start
                obj.health_bar_cap_bottom.Color   = settings.health_color_bottom
                obj.health_bar_cap_bottom.Radius  = settings.health_thickness/2
            else
                obj.health_bar_cap_top.Visible, obj.health_bar_cap_bottom.Visible = false, false
            end
            for i=1,10 do
                local sl = obj["health_bar_"..i]
                if settings.health and i <= math.ceil(hp*10) then
                    sl.Visible = true
                    local ss = bar_start:Lerp(bar_end, (i-1)/10)
                    local se = bar_start:Lerp(bar_end, i/10)
                    if i == math.ceil(hp*10) then se = bar_start:Lerp(bar_end, hp) end
                    sl.From, sl.To = ss, se
                    sl.Color = settings.health_color_top:Lerp(settings.health_color_bottom, 1-(i/10))
                else
                    sl.Visible = false
                end
            end

            if settings.skeleton then
                if not plr._skel_parts then
                    plr._skel_parts = {}
                    for _, part in next, character:GetChildren() do
                        local pn = skeleton_order[part.Name]
                        if pn then
                            local pi = character:FindFirstChild(pn)
                            local ln = obj["skeleton_"..part.Name]
                            if pi and ln then
                                plr._skel_parts[#plr._skel_parts+1] = { part=part, parent=pi, line=ln }
                            end
                        end
                    end
                end
                for i=1,#plr._skel_parts do
                    local e = plr._skel_parts[i]
                    if e.part.Parent and e.parent.Parent then
                        local a = camera:WorldToViewportPoint(e.part.Position)
                        local b = camera:WorldToViewportPoint(e.parent.Position)
                        e.line.From = Vector2.new(a.X, a.Y)
                        e.line.To   = Vector2.new(b.X, b.Y)
                    end
                end
            end

            cham.Adornee = character
            cham.Enabled = settings.chams
            if settings.chams then
                if settings.chams_visible_split then
                    cham.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    cham.DepthMode = settings.chams_visible_only and Enum.HighlightDepthMode.Occluded
                        or Enum.HighlightDepthMode.AlwaysOnTop
                end
                local int_off = (math.clamp(settings.chams_intensity or 0.5, 0, 1) - 0.5) * 2
                if settings.chams_health_reactive and not settings.chams_rainbow then
                    local hpp = math.clamp(health/math.max(maxhealth, 1), 0, 1)
                    cham.FillColor = Color3.fromHSV(hpp*(1/3), math.clamp(settings.chams_saturation or 1, 0, 1), 1)
                    cham.FillTransparency = math.clamp(settings.chams_fill_color[2] + int_off, 0, 0.99)
                elseif settings.chams_visible_split then
                    local vis = silent_aim and silent_aim.isvisible or false
                    if vis then
                        cham.FillColor, cham.FillTransparency = settings.chams_fill_color[1], math.clamp(settings.chams_fill_color[2]+int_off, 0, 0.99)
                    else
                        cham.FillColor, cham.FillTransparency = settings.chams_occluded_color[1], math.clamp(settings.chams_occluded_color[2]+int_off, 0, 0.99)
                    end
                elseif not settings.chams_rainbow and not settings.chams_pulse then
                    cham.FillColor        = settings.chams_fill_color[1]
                    cham.FillTransparency = math.clamp(settings.chams_fill_color[2]+int_off, 0, 0.99)
                end
                cham.OutlineColor        = settings.chamsoutline_color[1]
                cham.OutlineTransparency = settings.chams_outline and math.clamp(settings.chamsoutline_color[2]+int_off, 0, 0.99) or 1
            end
        end)
        plr:forceupdate()
    end

    local function create_object_esp(model, modelname)
        if not model then return end
        local name = identify_model(model, modelname)
        if not name then return end
        loaded_plrs[model] = { obj = { name = create_obj("Text", { Center=true, Visible=false, Text=name }) } }
        local plr = loaded_plrs[model]
        local label = plr.obj.name
        local ecm = esp_table.settings.corpse
        local setvis = false
        plr.connection = cheat.utility.new_heartbeat(function()
            if not ecm.enabled then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            local mp = get_mainpart(model, modelname)
            local wp = mp and mp.Position or model:GetPivot().Position
            local pos, on = worldToScreen(wp)
            if not on then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            local s = ""
            if ecm.name then s = name end
            if ecm.distance then
                local d = math.floor((camera.CFrame.p - wp).Magnitude/4)
                s = (s ~= "" and (s.." ["..d.."m]")) or ("["..d.."m]")
            end
            if s == "" then
                if setvis then for _,v in plr.obj do v.Visible = false end; setvis = false end
                return
            end
            label.Text    = s
            label.Position = pos
            label.Size    = esp_table.main_settings.textSize
            label.Font    = esp_table.main_settings.textFont
            label.Color   = ecm.color
            label.Outline = ecm.outline
            label.OutlineColor = ecm.outline_color
            if not setvis then for _,v in plr.obj do v.Visible = true end; setvis = true end
        end)
    end

    local function destroy_esp(player)
        if not loaded_plrs[player] then return end
        loaded_plrs[player].connection:Disconnect()
        for _,v in loaded_plrs[player].obj do v:Remove() end
        if loaded_plrs[player].chams_object then loaded_plrs[player].chams_object:Destroy() end
        loaded_plrs[player] = nil
    end

    function esp_table.load()
        if esp_table.__loaded then return end
        local function shortcut(is_obj, remove, name)
            return function(model)
                if remove then destroy_esp(model)
                elseif is_obj then create_object_esp(model, name)
                else create_esp(model) end
            end
        end
        for _, v in next, Players:GetPlayers() do
            if v ~= lplr then create_esp(v) end
        end
        local az = ws:FindFirstChild("AiZones")
        if az then
            for _, folder in next, az:GetChildren() do
                for _, npc in next, folder:GetChildren() do create_esp(npc, true) end
            end
        end
        local dropped = ws:FindFirstChild("DroppedItems")
        if dropped then
            for _, item in next, dropped:GetChildren() do create_object_esp(item, "corpse") end
        end
        esp_table.objectAdded = { Players.PlayerAdded:Connect(shortcut(false, false)) }
        esp_table.objectRemoving = { Players.PlayerRemoving:Connect(shortcut(false, true)) }
        if dropped then
            table.insert(esp_table.objectAdded,    dropped.ChildAdded:Connect(shortcut(true, false, "corpse")))
            table.insert(esp_table.objectRemoving, dropped.ChildRemoved:Connect(shortcut(true, true, "corpse")))
        end
        if az then
            for _, z in pairs(az:GetChildren()) do
                table.insert(esp_table.objectAdded,    z.ChildAdded:Connect(shortcut(false, false)))
                table.insert(esp_table.objectRemoving, z.ChildRemoved:Connect(shortcut(false, true)))
            end
        end
        esp_table.__loaded = true
    end

    function esp_table.unload()
        if not esp_table.__loaded then return end
        for p in next, loaded_plrs do destroy_esp(p) end
        for _, c in next, esp_table.objectAdded or {} do c:Disconnect() end
        for _, c in next, esp_table.objectRemoving or {} do c:Disconnect() end
        esp_table.__loaded = false
    end

    function esp_table.get_gun(player)
        local gun = "None"
        local P = ReplicatedPlayers:FindFirstChild(player.Name)
        if P and P:FindFirstChild("Status") and P.Status:FindFirstChild("GameplayVariables")
            and P.Status.GameplayVariables:FindFirstChild("EquippedTool")
            and P.Status.GameplayVariables.EquippedTool.Value then
            gun = tostring(P.Status.GameplayVariables.EquippedTool.Value)
        end

        if item_finder_esp_enabled then
            -- FIX #4: selected_finder_items — это dict из Obsidian dropdown.
            -- Было `#selected_finder_items > 0` → всегда 0 для dict.
            -- Стало `next(...) ~= nil` — универсальная проверка.
            if selected_finder_items and next(selected_finder_items) ~= nil then
                local p_inv = P and P:FindFirstChild("Inventory")
                if p_inv then
                    local found = {}
                    local function scan(item)
                        if selected_finder_items[item.Name] then
                            table.insert(found, item.Name)
                        end
                        local inner = item:FindFirstChild("Inventory")
                        if inner then
                            for _, subitem in ipairs(inner:GetChildren()) do scan(subitem) end
                        end
                        local atts = item:FindFirstChild("Attachments")
                        if atts then
                            for _, att in ipairs(atts:GetChildren()) do
                                if selected_finder_items[att.Name] then
                                    table.insert(found, att.Name)
                                end
                            end
                        end
                    end
                    for _, item in ipairs(p_inv:GetChildren()) do scan(item) end
                    if #found > 0 then
                        local unique = {}
                        for _, v in ipairs(found) do unique[v] = true end
                        local unique_list = {}
                        for k in pairs(unique) do table.insert(unique_list, k) end
                        gun = gun .. " | [" .. table.concat(unique_list, ", ") .. "]"
                    end
                end
            end
        end
        return gun
    end

    function esp_table.icaca()
        for _, v in pairs(loaded_plrs) do
            v.last_chams_update = 0
            task.spawn(function() if v.forceupdate then v:forceupdate() end end)
        end
    end

    do
        local h1, h2, sp = 0, 0, 0
        RunService:BindToRenderStep("ZalupaChamsRS", Enum.RenderPriority.Last.Value + 2, function(delta)
            local s = esp_table.settings and esp_table.settings.enemy
            if not s then return end
            if not (s.chams_rainbow or s.chams_pulse or s.chams_outline_pulse or s.chams_strobe) then return end
            h1 = (h1 + delta*0.3) % 1
            h2 = (h2 + delta*0.5) % 1
            sp = (sp + delta*12) % (2*math.pi)
            local sat = math.clamp(s.chams_saturation or 1, 0, 1)
            local rc  = Color3.fromHSV(h1, sat, 1)
            local oc  = Color3.fromHSV(h2, sat, 1)
            local pa  = (math.sin(tick()*3)+1)/2
            local sa  = (math.sin(sp)>0) and 0.0 or 0.99
            local wire= s.chams_material == "Wireframe"
            local io  = (math.clamp(s.chams_intensity or 0.5,0,1)-0.5)*2
            for _, pd in next, loaded_plrs do
                local ch = pd.chams_object
                if not (ch and ch.Enabled) then continue end
                if s.chams_strobe then
                    if not wire then ch.FillTransparency = sa end
                    if s.chams_outline then ch.OutlineTransparency = sa end
                    if s.chams_rainbow then
                        ch.FillColor = rc
                        if s.chams_outline then ch.OutlineColor = rc end
                    end
                    continue
                end
                if s.chams_rainbow and not s.chams_health_reactive then ch.FillColor = rc end
                if s.chams_outline_pulse and s.chams_outline then
                    ch.OutlineColor = oc
                    ch.OutlineTransparency = math.clamp((math.sin(tick()*5)+1)/2 + io, 0, 0.99)
                elseif s.chams_rainbow and s.chams_outline then
                    ch.OutlineColor = rc
                end
                if s.chams_pulse and not wire and not s.chams_health_reactive and not s.chams_visible_split then
                    ch.FillTransparency = math.clamp(pa + io, 0, 0.99)
                end
            end
        end)
    end

    cheat.EspLibrary = esp_table
end
