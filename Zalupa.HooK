WeaponGroup:AddToggle("InstantMosin", { Text = "Instant Mosin (R7)", Default = false, Callback = function(v)
    pcall(function()
        local ammo = ReplicatedStorage:FindFirstChild("AmmoTypes")
        if not ammo then return end
        if v then
            for _,a in pairs(ammo:GetChildren()) do
                if not original_recoils[a] then original_recoils[a] = a:GetAttribute("RecoilStrength") end
                a:SetAttribute("RecoilStrength", 1)
            end
        else
            for _,a in pairs(ammo:GetChildren()) do
                if original_recoils[a] then a:SetAttribute("RecoilStrength", original_recoils[a]) end
            end
        end
    end)
end })

