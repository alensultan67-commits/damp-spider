WorldGroup:AddToggle("Fullbright", { Text = "Fullbright", Default = false, Callback = function(v) world_globals.fullbright = v end })
WorldGroup:AddToggle("NoFog", { Text = "No Fog", Default = false, Callback = function(v) world_globals.nofog = v end })
WorldGroup:AddToggle("NoShadows", { Text = "No Shadows", Default = false, Callback = function(v) world_globals.noshadows = v end })
WorldGroup:AddToggle("NoGrass", { Text = "No Grass", Default = false, Callback = function(v) pcall(function() sethiddenproperty(workspace.Terrain, "Decoration", not v) end) end })
WorldGroup:AddToggle("NoClouds", { Text = "No Clouds", Default = false, Callback = function(v)
    local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
    if clouds then clouds.Enabled = not v end
end })
WorldGroup:AddToggle("NoLeafs", { Text = "No Leafs", Default = false, Callback = function(v) world_globals.noleafs = v end })

cheat.utility.new_heartbeat(function()
    if world_globals.fullbright then
        Lighting.Brightness = 10
        Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        Lighting.Ambient = Color3.fromRGB(255,255,255)
    end
    if world_globals.nofog then
        if Lighting.FogEnd < 9e5 then Lighting.FogEnd = 9e9 end
    end
    if world_globals.noshadows then
        if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
    end
end)

-- FIX #5: NoLeafs event-driven (не каждый heartbeat)
local _leafs_loop_active = false
cheat.utility.new_heartbeat(function()
    if not world_globals.noleafs then return end
    if _leafs_loop_active then return end
    _leafs_loop_active = true
    task.spawn(function()
        while world_globals.noleafs do
            local zones = Workspace:FindFirstChild("SpawnerZones")
            local foliage = zones and zones:FindFirstChild("Foliage")
            if foliage then
                for _, f in pairs(foliage:GetDescendants()) do
                    if f:FindFirstChildOfClass("SurfaceAppearance") and f.Transparency ~= 1 then
                        f.Transparency = 1
                    end
                end
            end
            task.wait(10)  -- раз в 10 сек вместо 60 раз/сек
        end
        _leafs_loop_active = false
    end)
end)

